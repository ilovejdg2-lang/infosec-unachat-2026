{
  "dependencies": {
    "@auth0/auth0-spa-js": "^2.30.0",
    "dotenv": "^18.0.9",
    "express": "4.22.3",
    "express-oauth2-jwt-bearer": "^1.11.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "chai": "^4.5.0",
    "jest": "^30.5.2",
    "mocha": "^10.2.0",
    "socket.io-client": "^4.8.4"
  },
  "overrides": {
    "proxy-addr": "2.0.8"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.js",
    "test": "mocha --ui bdd",
    "test:integration": "jest --runInBand",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:ci": "npm test && npm run test:integration && npm run test:e2e"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/integration/**/*.test.js"
    ]
  }
}
